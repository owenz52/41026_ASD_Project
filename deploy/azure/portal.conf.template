server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html home.html;

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","service":"portal"}';
    }

    # Shared static pages and assets.
    location / {
        try_files $uri $uri/ =404;
    }

    # Cloud deployment does not run the shared Multi-Agent service.
    location = /multi-agent.html {
        default_type text/plain;
        return 503 "Multi-Agent is disabled in the cloud.";
    }

    location /multi-agent-api/ {
        default_type application/json;
        return 503 '{"status":"disabled","error":"Multi-Agent is disabled in the cloud"}';
    }

    # Feature frontends.
    location /enrolment/ {
        proxy_pass https://${ENROLMENT_FRONTEND_HOST}/;
        proxy_set_header Host ${ENROLMENT_FRONTEND_HOST};
        proxy_ssl_server_name on;
    }

    location /assessments/ {
        proxy_pass https://${ASSESSMENT_FRONTEND_HOST}/;
        proxy_set_header Host ${ASSESSMENT_FRONTEND_HOST};
        proxy_ssl_server_name on;
    }

    location /calendar/ {
        proxy_pass https://${CALENDAR_FRONTEND_HOST}/;
        proxy_set_header Host ${CALENDAR_FRONTEND_HOST};
        proxy_ssl_server_name on;
    }

    location /notes/ {
        proxy_pass https://${NOTEBOOK_FRONTEND_HOST}/;
        proxy_set_header Host ${NOTEBOOK_FRONTEND_HOST};
        proxy_ssl_server_name on;
    }

    location /exams/ {
        proxy_pass https://${EXAM_FRONTEND_HOST}/;
        proxy_set_header Host ${EXAM_FRONTEND_HOST};
        proxy_ssl_server_name on;
    }

    # Authentication API.
    location /auth-api/ {
        proxy_pass https://${AUTH_BACKEND_HOST}/;
        proxy_set_header Host ${AUTH_BACKEND_HOST};
        proxy_ssl_server_name on;
    }

    # Feature APIs.
    location /enrolment-api/ {
        proxy_pass https://${ENROLMENT_BACKEND_HOST}/;
        proxy_set_header Host ${ENROLMENT_BACKEND_HOST};
        proxy_ssl_server_name on;
    }

    location /assessments-api/ {
        proxy_pass https://${ASSESSMENT_BACKEND_HOST}/;
        proxy_set_header Host ${ASSESSMENT_BACKEND_HOST};
        proxy_ssl_server_name on;
    }

    location /calendar-api/ {
        proxy_pass https://${CALENDAR_BACKEND_HOST}/;
        proxy_set_header Host ${CALENDAR_BACKEND_HOST};
        proxy_ssl_server_name on;
    }

    location /notes-api/ {
        proxy_pass https://${NOTEBOOK_BACKEND_HOST}/;
        proxy_set_header Host ${NOTEBOOK_BACKEND_HOST};
        proxy_ssl_server_name on;
    }

    location /exams-api/ {
        proxy_pass https://${EXAM_BACKEND_HOST}/;
        proxy_set_header Host ${EXAM_BACKEND_HOST};
        proxy_ssl_server_name on;
    }
}