# backend service port
BACKEND_PORT=5003

# base URL of the notebook-database service
DATABASE_SERVICE_URL=http://notebook-database:5004

# Ollama server and model used for AI-mode requests
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:0.5b

# summarise: skip the LLM entirely below this length, chunk above this length
SUMMARY_SKIP_THRESHOLD_CHARS=200
SUMMARY_CHUNK_THRESHOLD_CHARS=4000

# recommend: candidate search caps
RECOMMEND_CANDIDATE_LIMIT=8
RECOMMEND_CONTEXT_CHARS=200
RECOMMEND_KEYWORD_LIMIT=5

# reserved: not read by any code yet, for when course names need surfacing
# from Owen's course service
# COURSE_SERVICE_URL=
